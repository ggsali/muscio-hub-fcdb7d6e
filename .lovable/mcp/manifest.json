        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Optionaler Status-Filter, z. B. 'offen', 'in_produktion', 'geliefert'."
            },
            "search": {
              "type": "string",
              "description": "Suchbegriff für Auftragsname oder Beschreibung."
            },
            "limit": {
              "type": "integer",
              "description": "Maximale Anzahl Ergebnisse (Standard 20, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_order",
        "title": "Auftrag im Detail",
        "description": "Liefert einen einzelnen Auftrag inklusive Teile (parts) und Rechnungen (bills) anhand der Auftrags-ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string",
              "description": "UUID des Auftrags."
