      {
        "name": "list_open_bills",
        "title": "Offene Rechnungen",
        "description": "Listet Rechnungen (bills) auf. Standardmässig nur unbezahlte Rechnungen, sortiert nach Fälligkeitsdatum.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_paid": {
              "type": "boolean",
